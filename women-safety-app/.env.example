# === REQUIRED ===

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# Gemini AI — get from https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# === DATABASE (Railway provides this automatically) ===
# Leave blank for local SQLite; Railway sets this to a PostgreSQL URL automatically
DATABASE_URL=

# === CORS (set to your Vercel frontend URL in production) ===
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# === OPTIONAL SMS PROVIDERS ===
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS message style: 'rich' (with emoji) or 'otp' (plain text)
SMS_STYLE=rich

# === RUNTIME ===
# Set to 'development' for debug mode and HTTP-only cookies locally
FLASK_ENV=production

# Gemini model config (defaults are fine)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
